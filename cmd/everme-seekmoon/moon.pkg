import {
  "moonbitlang/core/argparse",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x/sys",
  "chaijie2018/EverMe-for-SeekMoon/api",
  "chaijie2018/EverMe-for-SeekMoon/cli",
  "chaijie2018/EverMe-for-SeekMoon/config",
  "chaijie2018/EverMe-for-SeekMoon/creds",
  "chaijie2018/EverMe-for-SeekMoon/importer",
  "chaijie2018/EverMe-for-SeekMoon/install",
  "chaijie2018/EverMe-for-SeekMoon/mcp",
  "chaijie2018/EverMe-for-SeekMoon/redact",
}

supported_targets = "+native +wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/stdio",
  ],
)

pkgtype(kind: "executable")
